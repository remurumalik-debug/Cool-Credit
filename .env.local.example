# CoolCredit Environment Configuration
# Default local MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/coolcredit

# JWT session signing secret (minimum 32 characters in production)
JWT_SECRET=coolcredit_super_secure_jwt_secret_dev_2026_pilot_lokoja

# Pilot default payout rate in kobo per kg (e.g. 450000 kobo = ₦4,500/kg)
DEFAULT_PAYOUT_RATE_KOBO=450000

# Variance threshold percentage for operator fraud warning
VARIANCE_THRESHOLD_PCT=20

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
